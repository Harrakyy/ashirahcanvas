# ==============================================================================
# AshiraTech SaaS Platform — Environment Variables
# ==============================================================================

# Database (PostgreSQL via Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ashirah"

# Authentication & Session Security (HMAC-SHA256)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production-2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Negotiation Engine (Groq LLaMA 3.3 & Google Gemini)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Payment Gateway (Duitku API v2)
DUITKU_MERCHANT_CODE="your_duitku_merchant_code"
DUITKU_API_KEY="your_duitku_api_key"
DUITKU_ENV="sandbox" # "sandbox" | "production"
DUITKU_MOCK="false" # "false" di production. Set "true" hanya untuk offline/local dev tanpa Duitku API keys
DUITKU_CALLBACK_URL="http://localhost:3000/api/webhook/duitku"
DUITKU_RETURN_URL="http://localhost:3000/payment/success"

# Shipping & Logistics (Biteship API)
BITESHIP_API_KEY="your_biteship_api_key_here"
BITESHIP_ENV="stub" # "stub" (tanpa akun/mock rates) | "production"

# Email Notifications (Resend)
# Tanpa domain: pakai onboarding@resend.dev (hanya bisa kirim ke email akun Resend sendiri)
# Dengan domain: verifikasi domain di resend.com/domains, isi EMAIL_FROM_ADDRESS
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM_ADDRESS="notifications@ashiratech.com"   # ganti saat domain sudah verified
EMAIL_FROM_NAME="AshiraTech"                        # prefix display name sebelum nama tenant

# Email internal Ashira — BCC ke sini setiap ada transaksi (order, payment, pengiriman)
ASHIRA_BCC_EMAIL="orders@ashiratech.com"

# Storage & Redis (Optional / Existing)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""