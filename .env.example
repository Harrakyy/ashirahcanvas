# -----------------------------------------------------------------
# ASHIRAH CANVAS — Environment Variables Template
# Copy file ini menjadi .env.local dan isi dengan nilai yang sesuai.
#
#   cp .env.example .env.local
#
# Untuk Take-Home Test kandidat: bagian GROQ + Upstash Redis + Midtrans
# diperlukan hanya untuk fitur AI Chat & Negosiasi.
# Fitur CANVAS (upload gambar, mockup, layer) berjalan 100% tanpa env vars.
# -----------------------------------------------------------------

# -- AI Chat (Groq) ------------------------------------------------
# Daftarkan akun gratis di https://console.groq.com
# Model yang dipakai: llama-3.3-70b-versatile (free tier cukup)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# -- Session Storage (Upstash Redis) -------------------------------
# Daftarkan akun gratis di https://upstash.com ? buat database Redis
# Salin REST API URL dan Token dari dashboard Upstash
KV_REST_API_URL="https://YOUR_DATABASE_NAME.upstash.io"
KV_REST_API_TOKEN="YOUR_UPSTASH_TOKEN_HERE"

# -- Payment Gateway (Midtrans) ------------------------------------
# Untuk keperluan test, gunakan Sandbox credentials dari https://dashboard.midtrans.com
# JANGAN gunakan Production key di lingkungan development
MIDTRANS_SERVER_KEY=Mid-server-YOUR_SERVER_KEY_HERE
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-YOUR_CLIENT_KEY_HERE
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# -- App URL (opsional, default: http://localhost:3000) ------------
# Digunakan untuk redirect URL setelah payment success
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- AI Vision (STUB — belum aktif, tidak perlu diisi) -------------
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
